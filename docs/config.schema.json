{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Orgenda workspace configuration v1",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {"const": 1},
    "workflow": {
      "type": "object",
      "properties": {
        "sequences": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/sequence"}},
        "keywords": {"type": "object", "additionalProperties": {"$ref": "#/$defs/keyword"}}
      }
    },
    "capture": {
      "type": "object",
      "properties": {
        "defaultTemplate": {"type": "string"},
        "templates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/template"}}
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "inbox": {"$ref": "#/$defs/path"},
        "attachments": {"$ref": "#/$defs/path"},
        "journal": {"$ref": "#/$defs/path"},
        "archive": {"type": "string"},
        "refile": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "refileMaxLevel": {"type": "integer", "minimum": 1, "maximum": 99}
      }
    },
    "agenda": {
      "type": "object",
      "properties": {
        "sources": {"type": "array", "items": {"$ref": "#/$defs/path"}},
        "excluded": {"type": "array", "items": {"$ref": "#/$defs/path"}}
      }
    },
    "logging": {
      "type": "object",
      "properties": {
        "done": {"$ref": "#/$defs/logRule"},
        "reschedule": {"$ref": "#/$defs/logRule"},
        "redeadline": {"$ref": "#/$defs/logRule"},
        "drawer": {"type": "string"}
      }
    },
    "reminders": {
      "type": "object",
      "properties": {
        "advanceMinutes": {"type": "integer", "minimum": 0, "maximum": 1440},
        "repeatMinutes": {"type": "integer", "minimum": 1, "maximum": 1440},
        "deadlineWarningDays": {"type": "integer", "minimum": 0, "maximum": 365}
      }
    }
  },
  "$defs": {
    "color": {"enum": ["default", "gray", "red", "orange", "amber", "green", "cyan", "blue", "purple", "pink"]},
    "icon": {"enum": ["default", "circle", "arrow", "hourglass", "pause", "moon", "exclamation", "flag", "star", "check", "cross"]},
    "logRule": {"enum": ["none", "time", "note"]},
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "path": {"type": "string", "minLength": 1, "pattern": "^(?!/|~)(?!.*(?:^|/)\\.\\.(?:/|$))[^\\\\:\\u0000\\r\\n]+$"},
    "keyword": {
      "type": "object",
      "properties": {
        "label": {"type": "string"},
        "key": {"type": "string", "maxLength": 1},
        "icon": {"$ref": "#/$defs/icon"},
        "color": {"$ref": "#/$defs/color"},
        "log": {
          "type": "object",
          "properties": {"enter": {"$ref": "#/$defs/logRule"}, "leave": {"$ref": "#/$defs/logRule"}}
        }
      }
    },
    "sequence": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "process": {"allOf": [{"$ref": "#/$defs/strings"}, {"minItems": 1}]},
        "terminal": {"allOf": [{"$ref": "#/$defs/strings"}, {"minItems": 1}]},
        "initial": {"type": "string"},
        "complete": {"type": "string"},
        "reopen": {"type": "string"}
      }
    },
    "template": {
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string"},
        "key": {"type": "string"},
        "group": {"type": "string"},
        "type": {"enum": ["entry", "item", "checkitem", "plain"]},
        "template": {"type": "string"},
        "prepend": {"type": "boolean"},
        "emptyLines": {"type": "integer", "minimum": 0, "maximum": 10},
        "target": {
          "type": "object",
          "properties": {
            "type": {"enum": ["file", "headline", "outline", "datetree"]},
            "path": {"$ref": "#/$defs/path"},
            "outline": {"type": "array", "items": {"type": "string", "minLength": 1}}
          }
        }
      }
    }
  }
}
