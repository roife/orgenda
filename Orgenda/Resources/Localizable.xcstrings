{
  "sourceLanguage" : "en",
  "strings" : {
    "This image link has an invalid or unsupported path." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图片链接的路径无效或不受支持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖片連結的路徑無效或不受支援。"
          }
        }
      }
    },
    "This image path leaves the selected workspace folder." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图片路径超出了所选工作区文件夹。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "圖片路徑超出了所選工作區資料夾。"
          }
        }
      }
    },
    "This attachment needs a DIR or ID property on its heading or an ancestor." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请在当前标题或上级标题中设置 DIR 或 ID 属性，以定位附件。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請在目前標題或上層標題中設定 DIR 或 ID 屬性，以定位附件。"
          }
        }
      }
    },
    "The attachment ID cannot be used as a directory name." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附件 ID 无法用作目录名称。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "附件 ID 無法用作目錄名稱。"
          }
        }
      }
    },
    "The image URL is invalid or contains embedded credentials." : {
      "extractionState" : "manual",
      "localizations" : {
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "图片网址无效，或包含用户名及密码。"
