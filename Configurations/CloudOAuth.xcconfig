// Public application identifiers, not client secrets. See docs/CloudStorage.md.
// Project settings must not override these with empty values in project.yml.
ORGENDA_ONEDRIVE_CLIENT_ID =
ORGENDA_GOOGLE_CLIENT_ID =
// A syntactically valid scheme keeps unconfigured Debug builds installable.
// The setup script replaces it with the reversed, registered Google client ID.
ORGENDA_GOOGLE_URL_SCHEME = com.roifewu.orgenda.google
ORGENDA_DROPBOX_CLIENT_ID =

// $() prevents xcconfig from treating // as a comment.
ORGENDA_ONEDRIVE_REDIRECT_URI = orgenda-onedrive:/$()/oauth
ORGENDA_GOOGLE_REDIRECT_URI = $(ORGENDA_GOOGLE_URL_SCHEME):/oauth2redirect
ORGENDA_DROPBOX_REDIRECT_URI = orgenda-dropbox:/$()/oauth

// Generated by Scripts/cloud_oauth.py configure; shared by Debug and Release.
#include? "CloudOAuth.local.xcconfig"
